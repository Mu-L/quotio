    "Widgets show the last available observation. iOS controls update timing; your computer and VPN must be reachable to get new data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets show the last available observation. iOS controls update timing; your computer and VPN must be reachable to get new data."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget hiển thị dữ liệu ghi nhận gần nhất. iOS quyết định thời điểm cập nhật; máy tính và VPN phải kết nối được để lấy dữ liệu mới."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets affichent la dernière observation. iOS décide des mises à jour ; l’ordinateur et le VPN doivent être accessibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件显示最近的可用数据。更新时间由 iOS 决定；获取新数据需要能访问电脑和 VPN。"
          }
        }
      }
    },
    "Your accounts will be available in the widget editor after connecting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your accounts will be available in the widget editor after connecting."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tài khoản sẽ xuất hiện trong trình sửa widget sau khi kết nối."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos comptes apparaîtront dans l’éditeur de widget après connexion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后，可在小组件编辑器中选择账户。"
          }
        }
      }
    },
    "Your provider credentials stay on your computer. Quotio connects through your local network or private VPN using HTTPS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider credentials stay on your computer. Quotio connects through your local network or private VPN using HTTPS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin đăng nhập nhà cung cấp vẫn ở trên máy tính. Quotio kết nối qua mạng nội bộ hoặc VPN riêng bằng HTTPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants des services restent sur votre ordinateur. Quotio utilise HTTPS sur votre réseau local ou VPN privé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商凭据保留在电脑上。Quotio 通过局域网或私有 VPN 使用 HTTPS 连接。"
          }
        }
      }
    },
