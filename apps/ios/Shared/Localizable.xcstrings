    "The host is busy or its credential storage is locked. Retry after checking the host.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host is busy or its credential storage is locked. Retry after checking the host."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy đang bận hoặc kho thông tin đăng nhập bị khóa. Kiểm tra máy rồi thử lại."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hôte est occupé ou son stockage sécurisé est verrouillé. Vérifiez-le puis réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机正忙或凭据存储已锁定。检查主机后请重试。"
          }
        }
      }
    },
    "The host must be awake and running. Widgets update when iOS allows, and may show older data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host must be awake and running. Widgets update when iOS allows, and may show older data."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy host phải thức và đang chạy. Widget cập nhật khi iOS cho phép và có thể hiển thị dữ liệu cũ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hôte doit être éveillé et actif. Les widgets se mettent à jour selon iOS et peuvent afficher des données anciennes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机必须保持唤醒并运行。小组件由 iOS 安排更新，可能显示旧数据。"
          }
        }
      }
    },
    "The saved credential could not be removed. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved credential could not be removed. Try again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xóa quyền truy cập đã lưu. Hãy thử lại."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer l’identifiant enregistré. Réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除已保存的凭据。请重试。"
          }
        }
      }
    },
    "This connection belongs to a different host. Pair it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection belongs to a different host. Pair it again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối này thuộc máy khác. Hãy ghép nối lại."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion appartient à un autre hôte. Associez-le à nouveau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接属于其他主机。请重新配对。"
          }
        }
      }
    },
    "This device credential is no longer valid. Pair the host again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device credential is no longer valid. Pair the host again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập thiết bị không còn hiệu lực. Hãy ghép nối máy lại."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet identifiant n’est plus valide. Associez à nouveau l’hôte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备凭据已失效。请重新配对主机。"
