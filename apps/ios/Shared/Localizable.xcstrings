    "Check the host address before connecting. Your device token will be sent to this address after you tap Connect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the host address before connecting. Your device token will be sent to this address after you tap Connect."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra địa chỉ máy trước khi kết nối. Token thiết bị sẽ được gửi đến địa chỉ này khi bạn chạm Kết nối."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’adresse de l’hôte. Votre jeton sera envoyé à cette adresse lorsque vous toucherez Connecter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先核对主机地址。点击连接后，设备令牌将发送到此地址。"
          }
        }
      }
    },
