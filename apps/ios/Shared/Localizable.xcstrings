    "Reloading reads the host's latest snapshot. Quota refresh is controlled on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloading reads the host's latest snapshot. Quota refresh is controlled on the computer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lại lấy dữ liệu mới nhất đã có trên máy host. Việc làm mới hạn mức được điều khiển trên máy tính."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rechargement lit les dernières données de l’hôte. L’actualisation du quota se règle sur l’ordinateur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载会读取主机的最新快照。配额刷新由电脑控制。"
          }
        }
      }
    },
