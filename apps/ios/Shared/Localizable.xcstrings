{
  "sourceLanguage": "en",
  "strings": {
    "1. On your Mac, open Quotio and choose Pair iPhone.\n2. Choose Local network or Tailscale IP, then create a pairing code.\n3. Scan or paste the code here.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"1. On your Mac, open Quotio and choose Pair iPhone.\n2. Choose Local network or Tailscale IP, then create a pairing code.\n3. Scan or paste the code here."}},"vi":{"stringUnit":{"state":"translated","value":"1. Trên Mac, mở Quotio và chọn Ghép nối iPhone.\n2. Chọn Mạng nội bộ hoặc Tailscale IP, rồi tạo mã ghép nối.\n3. Quét hoặc dán mã vào đây."}},"fr":{"stringUnit":{"state":"translated","value":"1. Sur votre Mac, ouvrez Quotio et choisissez Associer un iPhone.\n2. Choisissez Réseau local ou IP Tailscale, puis créez un code de jumelage.\n3. Scannez ou collez le code ici."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"1. 在 Mac 上打开 Quotio，然后选择配对 iPhone。\n2. 选择局域网或 Tailscale IP，然后创建配对码。\n3. 在此扫描或粘贴配对码。"}}}},
    "Access expires %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Access expires %@"}},"vi":{"stringUnit":{"state":"translated","value":"Quyền truy cập hết hạn %@"}},"fr":{"stringUnit":{"state":"translated","value":"L’accès expire %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"访问权限到期时间：%@"}}}},
    "Add computer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add computer"}},"vi":{"stringUnit":{"state":"translated","value":"Thêm máy tính"}},"fr":{"stringUnit":{"state":"translated","value":"Ajouter un ordinateur"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加电脑"}}}},
    "Advanced: HTTPS proxy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Advanced: HTTPS proxy"}},"vi":{"stringUnit":{"state":"translated","value":"Nâng cao: HTTPS proxy"}},"fr":{"stringUnit":{"state":"translated","value":"Avancé : proxy HTTPS"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"高级：HTTPS 代理"}}}},
    "Camera access is off. Paste the code, or allow Camera access in Settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Camera access is off. Paste the code, or allow Camera access in Settings."}},"vi":{"stringUnit":{"state":"translated","value":"Quyền truy cập Camera đang tắt. Hãy dán mã hoặc cho phép Camera trong Cài đặt."}},"fr":{"stringUnit":{"state":"translated","value":"L’accès à la caméra est désactivé. Collez le code ou autorisez la caméra dans Réglages."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"相机访问权限已关闭。请粘贴配对码，或在“设置”中允许相机访问。"}}}},
    "Computer name": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Computer name"}},"vi":{"stringUnit":{"state":"translated","value":"Tên máy tính"}},"fr":{"stringUnit":{"state":"translated","value":"Nom de l’ordinateur"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"电脑名称"}}}},
    "Computers": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Computers"}},"vi":{"stringUnit":{"state":"translated","value":"Máy tính"}},"fr":{"stringUnit":{"state":"translated","value":"Ordinateurs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"电脑"}}}},
    "Connected": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connected"}},"vi":{"stringUnit":{"state":"translated","value":"Đã kết nối"}},"fr":{"stringUnit":{"state":"translated","value":"Connecté"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已连接"}}}},
    "Connecting to %@…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connecting to %@…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang kết nối với %@…"}},"fr":{"stringUnit":{"state":"translated","value":"Connexion à %@…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在连接到 %@…"}}}},
    "Done": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Done"}},"vi":{"stringUnit":{"state":"translated","value":"Xong"}},"fr":{"stringUnit":{"state":"translated","value":"Terminé"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完成"}}}},
    "For custom HTTPS proxies only. Check the address before connecting.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"For custom HTTPS proxies only. Check the address before connecting."}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ dành cho HTTPS proxy tùy chỉnh. Kiểm tra địa chỉ trước khi kết nối."}},"fr":{"stringUnit":{"state":"translated","value":"Pour les proxys HTTPS personnalisés uniquement. Vérifiez l’adresse avant la connexion."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅用于自定义 HTTPS 代理。连接前请检查地址。"}}}},
    "Point the camera at the code on your Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Point the camera at the code on your Mac."}},"vi":{"stringUnit":{"state":"translated","value":"Hướng camera vào mã trên màn hình Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Dirigez la caméra vers le code affiché sur votre Mac."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将相机对准 Mac 上的配对码。"}}}},
    "Pair again": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair again"}},"vi":{"stringUnit":{"state":"translated","value":"Ghép nối lại"}},"fr":{"stringUnit":{"state":"translated","value":"Associer à nouveau"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新配对"}}}},
    "Pair this computer again": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair this computer again"}},"vi":{"stringUnit":{"state":"translated","value":"Ghép nối lại máy tính này"}},"fr":{"stringUnit":{"state":"translated","value":"Associer à nouveau cet ordinateur"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新配对此电脑"}}}},
    "QR scanning is unavailable. Paste the pairing code instead.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"QR scanning is unavailable. Paste the pairing code instead."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể quét mã QR. Hãy dán mã ghép nối."}},"fr":{"stringUnit":{"state":"translated","value":"Le scan QR est indisponible. Collez plutôt le code de jumelage."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法扫描二维码。请改为粘贴配对码。"}}}},
    "Remove computer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove computer"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa máy tính"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer l’ordinateur"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除电脑"}}}},
    "Remove this computer?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove this computer?"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa máy tính này?"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer cet ordinateur ?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除此电脑？"}}}},
    "Removing a computer deletes its saved credential on this iPhone. Revoke the device on the computer to end its access everywhere.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Removing a computer deletes its saved credential on this iPhone. Revoke the device on the computer to end its access everywhere."}},"vi":{"stringUnit":{"state":"translated","value":"Xóa máy tính sẽ xóa thông tin truy cập đã lưu trên iPhone này. Hãy thu hồi thiết bị trên máy tính để chấm dứt quyền truy cập ở mọi nơi."}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer un ordinateur efface son identifiant enregistré sur cet iPhone. Révoquez l’appareil sur l’ordinateur pour mettre fin à son accès partout."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除电脑会删除此 iPhone 上保存的凭据。请在电脑上撤销此设备，以彻底终止其访问权限。"}}}},
    "Scan pairing code": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan pairing code"}},"vi":{"stringUnit":{"state":"translated","value":"Quét mã ghép nối"}},"fr":{"stringUnit":{"state":"translated","value":"Scanner le code de jumelage"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"扫描配对码"}}}},
    "The code grants read-only access. Keep it private.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The code grants read-only access. Keep it private."}},"vi":{"stringUnit":{"state":"translated","value":"Mã chỉ cấp quyền xem. Hãy giữ kín mã này."}},"fr":{"stringUnit":{"state":"translated","value":"Le code accorde un accès en lecture seule. Gardez-le privé."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此配对码仅授予只读访问权限。请勿分享。"}}}},
    "This pairing code is invalid or has expired.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This pairing code is invalid or has expired."}},"vi":{"stringUnit":{"state":"translated","value":"Mã ghép nối không hợp lệ hoặc đã hết hạn."}},"fr":{"stringUnit":{"state":"translated","value":"Ce code de jumelage est invalide ou a expiré."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此配对码无效或已过期。"}}}},
    "Try again": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try again"}},"vi":{"stringUnit":{"state":"translated","value":"Thử lại"}},"fr":{"stringUnit":{"state":"translated","value":"Réessayer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试"}}}},
    "You can now view this computer's quota and add widgets.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You can now view this computer's quota and add widgets."}},"vi":{"stringUnit":{"state":"translated","value":"Giờ đây bạn có thể xem hạn mức của máy tính này và thêm widget."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez maintenant consulter les quotas de cet ordinateur et ajouter des widgets."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现在你可以查看此电脑的配额并添加小组件。"}}}},
