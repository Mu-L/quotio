    },
    "This host uses an unsupported API. Update Quotio on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This host uses an unsupported API. Update Quotio on the computer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "API của máy này chưa được hỗ trợ. Cập nhật Quotio trên máy tính."
          }
        },
        "fr": {
          "stringUnit": {
