    "Provider-reported days. Missing days are unavailable, not zero. Dates keep the provider's calendar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider-reported days. Missing days are unavailable, not zero. Dates keep the provider's calendar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày do nhà cung cấp báo cáo. Ngày thiếu dữ liệu không được tính là 0. Giữ nguyên ngày theo lịch của nhà cung cấp."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours fournis par le service. Une journée manquante n’est pas un zéro. Les dates suivent le calendrier du service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期由服务商报告。缺失数据不代表零用量。日期保留服务商的日历定义。"
          }
        }
      }
    },
